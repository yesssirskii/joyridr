{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=joyridr;Username=postgres"
  },
  "Jwt": {
    "Issuer": "joyridr",
    "Audience": "joyridr-ios",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Rides": {
    "MinLeadTimeMinutes": 120,
    "MaxAdvanceDays": 60,
    "MinDurationMinutes": 30,
    "MaxDurationMinutes": 240,
    "StepMinutes": 30,
    "DriverResponseHours": 24,
    "PaymentWindowMinutes": 15,
    "FreeCancellationHours": 24
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  }
}
